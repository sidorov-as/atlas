:80 {
    encode zstd gzip
    header -Server

    handle /static/* {
        # The request path keeps its /static prefix, so root is the parent of STATIC_ROOT.
        root * /var/www/django
        file_server
    }
    handle /api/* {
        reverse_proxy backend:8000
    }
    # SPA login/session endpoints (`/auth/browser/v1/...`).
    handle /auth/* {
        reverse_proxy backend:8000
    }
    # allauth's provider redirect/callback routes (OIDC, Gitea OAuth2).
    handle /accounts/* {
        reverse_proxy backend:8000
    }
    handle /_allauth/* {
        reverse_proxy backend:8000
    }
    handle /admin/* {
        reverse_proxy backend:8000
    }
    # `/healthz/plugins/`
    # — first frontend-origin read of this ops health-check route; the
    # Docker healthcheck curls the backend container directly and never
    # needed this proxied.
    handle /healthz/* {
        reverse_proxy backend:8000
    }
    handle {
        root * /usr/share/caddy
        try_files {path} /index.html
        file_server
    }
}
