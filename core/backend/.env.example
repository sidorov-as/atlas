DJANGO_ENV=development
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://localhost:8080
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
DJANGO_SECURE_SSL_REDIRECT=false

POSTGRES_DB=atlas
POSTGRES_USER=atlas
POSTGRES_PASSWORD=atlas
DJANGO_DATABASE_HOST=localhost
DJANGO_DATABASE_PORT=5432

ATLAS_DEMO_ADMIN_USERNAME=admin
ATLAS_DEMO_ADMIN_PASSWORD=atlas-demo-admin-password

INGESTOR_POLL_INTERVAL=60

# atlas.apis: comma-separated hosts exempted from the
# HTTPS-only / non-reserved-address requirement when resolving an API's
# spec_url — e.g. an internal Git or artifact server. Leave unset to require
# every spec_url to be HTTPS and publicly routable.
# ATLAS_APIS_SPEC_URL_ALLOWLIST=internal-git.example.com

# atlas.auth.oidc: leave unset to run with
# atlas.auth.local only. Set the four required values to enable SSO alongside
# it. OIDC_DISCOVERY_URL is the OpenID Provider Configuration document URL;
# OIDC_EXPECTED_ISSUER is the exact issuer identifier and is never inferred
# from discovery. (OIDC_ISSUER is a deprecated alias for OIDC_DISCOVERY_URL.)
# OIDC_DISCOVERY_URL=https://idp.example.com/.well-known/openid-configuration
# OIDC_EXPECTED_ISSUER=https://idp.example.com
# OIDC_CLIENT_ID=change-me
# OIDC_CLIENT_SECRET=change-me
# OIDC_GROUPS_CLAIM=groups

# Production-like Compose defaults to http://localhost:8080. Override these
# for a deployed hostname and enable HTTPS redirects at an external ingress.
# ATLAS_PORT=8080
