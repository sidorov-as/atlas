# DISPOSABLE DEVELOPMENT VALUES ONLY. Copy this file to .env and replace the
# values if the example is reachable by anyone else.

# Merges the generated Meilisearch service into the base topology.
COMPOSE_FILE=compose.yaml:generated/compose.override.yaml

ATLAS_PORT=18100

POSTGRES_DB=atlas_search_example
POSTGRES_USER=atlas_search_example
POSTGRES_PASSWORD=search-db-only-4Mango-River-8

DJANGO_SECRET_KEY=search-django-only-9Violet-Bridge-3
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:18100

ATLAS_BOOTSTRAP_USERNAME=search-admin
ATLAS_BOOTSTRAP_EMAIL=search-admin@example.test
ATLAS_BOOTSTRAP_GROUP=search-platform
ATLAS_BOOTSTRAP_PASSWORD=search-admin-only-7Copper-Forest-2

# Meilisearch access key (at least 16 bytes), shared by the engine and Atlas.
ATLAS_SERVICE_MEILISEARCH_KEY=search-meili-only-5Amber-Lantern-9
